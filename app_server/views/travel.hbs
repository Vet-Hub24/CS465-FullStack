<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
  <meta charset="UTF-8">
  <title>Travel - Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
  <div id="background">
    <div id="page">
      {{> header }}

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Travel</h1>

              {{#if message}}
                <p>{{message}}</p>
              {{/if}}

              {{#each trips}}
                <ul>
                  <li>
                    <a href="/api/trips/{{this.code}}">
                      <img src="/images/{{this.image}}" alt="{{this.name}}">
                    </a>
                    <h2>{{this.name}}</h2>
                    <p>{{this.description}}</p>
                  </li>
                </ul>
              {{/each}}

            </div>
          </div>
        </div>
      </div>
    </div>

    {{> footer }}
  </div>
</body>
</html>