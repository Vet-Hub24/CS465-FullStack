<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} - Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {{> header}}

  <main class="shell page-content">
    <div class="page-heading">
      <p class="eyebrow">Available packages</p>
      <h1>Travel Getaways</h1>
      <p>Live trip data retrieved through the Travlr REST API.</p>
    </div>

    {{#if message}}
      <div class="notice">{{message}}</div>
    {{/if}}

    <section class="trip-grid">
      {{#each trips}}
        <article class="trip-card">
          <div class="trip-card-visual" aria-hidden="true">
            <span>{{this.code}}</span>
          </div>
          <div class="trip-card-body">
            <div class="trip-meta">
              <span>{{this.length}}</span>
              <span>{{this.perPerson}} / person</span>
            </div>
            <h2>{{this.name}}</h2>
            <p class="resort">{{this.resort}}</p>
            <p>{{this.description}}</p>
            <a class="text-link" href="/api/trips/{{this.code}}">View API record →</a>
          </div>
        </article>
      {{/each}}
    </section>
  </main>

  {{> footer}}
</body>
</html>
